# ─────────────────────────────────────────────────────────
# 실제 값을 넣은 .env 파일은 절대 커밋하지 마세요 (.gitignore 처리됨)
# ─────────────────────────────────────────────────────────

# LMS 호스트 (예: https://lms.example.ac.kr)
LMS_HOST=https://<LMS_HOST>

# 기본 컨텍스트 경로 (보통 /lms)
LMS_BASE_PATH=/lms

# 담당 과목 식별자 — 강의실 URL 또는 npm run collect:courses 결과에서 확인
# 형태: 학기(202610) + 과목코드(UN00607...) + 분반(Y2)
COURSE_ID=202610UN0060****Y2
CLASS_NO=Y2

# 로컬 데이터 저장 위치
DB_PATH=./data/lms.sqlite
DOWNLOAD_DIR=./data/submissions

# 세션 저장 위치 (Playwright storageState)
AUTH_STATE_PATH=./.auth/state.json

# 요청 간 최소 간격(ms) — 학교 서버에 부담을 주지 않기 위한 값. 낮추지 마세요.
REQUEST_INTERVAL_MS=1200

# 채점 초안 생성에 사용할 Claude 모델
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# 쓰기 작업 안전장치. true 이면 어떤 저장도 실제로 수행하지 않습니다.
DRY_RUN=true
