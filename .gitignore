node_modules/
dist/
# 학습자료 산출물(materials/dist)은 배포용 결과물이라 함께 둔다.
# 위 dist/ 는 web/ · bridge/ 의 빌드 찌꺼기를 막으려는 것이다.
!materials/dist/
# tsc -b 가 남기는 캐시. 빌드할 때마다 바뀌어 커밋에 잡음이 낀다.
*.tsbuildinfo
.env
.env.local
.env.*.local

# 세션 쿠키 / 인증 상태 — 절대 커밋 금지
.auth/
storageState.json
cookies.json

# 실제 학생 데이터 — 절대 커밋 금지
data/
*.sqlite
*.sqlite3
*.db
downloads/
submissions/
exports/
*_성적.csv

# Supabase 로컬 개발
supabase/.branches/
supabase/.temp/

# 디자인 근거 자료 (목업 HTML · 스크린샷) — 로컬에만 둔다
univ-design/

# 로그
logs/
*.log
npm-debug.log*

.DS_Store
Thumbs.db
